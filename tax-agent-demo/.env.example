# ---- LLM 端点中立三变量（换 DeepSeek/Qwen/OpenAI 只改这里）----
# 示例：智谱 GLM（OpenAI 兼容端点）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=glm-4.6

# ---- 可选：模型私有开关（JSON 文本，原样透传进请求体）----
# DeepSeek 思考模式默认开启时会拒绝 tool_choice 强制（langchain 结构化输出依赖它），
# 用 DeepSeek 需关闭思考；GLM/Qwen 等不需要时删掉本行即可
#LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
